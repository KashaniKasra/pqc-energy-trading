+package sw
+
+import (
+	"crypto/sha256"
+	"errors"
+
+	"github.com/hyperledger/fabric/bccsp"
+)
+
+type pqPrivateKey struct {
+	algorithm string
+	secretKey []byte
+	publicKey []byte
+}
+
+func (k *pqPrivateKey) Bytes() ([]byte, error) {
+	return nil, errors.New("Not supported.")
+}
+
+func (k *pqPrivateKey) SKI() []byte {
+	if len(k.publicKey) == 0 {
+		return nil
+	}
+
+	sum := sha256.Sum256(k.publicKey)
+	return sum[:]
+}
+
+func (k *pqPrivateKey) Symmetric() bool {
+	return false
+}
+
+func (k *pqPrivateKey) Private() bool {
+	return true
+}
+
+func (k *pqPrivateKey) PublicKey() (bccsp.Key, error) {
+	if len(k.publicKey) == 0 {
+		return nil, errors.New("public key is not available")
+	}
+
+	return &pqPublicKey{
+		algorithm: k.algorithm,
+		publicKey: append([]byte(nil), k.publicKey...),
+	}, nil
+}
+
+type pqPublicKey struct {
+	algorithm string
+	publicKey []byte
+}
+
+func (k *pqPublicKey) Bytes() ([]byte, error) {
+	if len(k.publicKey) == 0 {
+		return nil, errors.New("public key is not available")
+	}
+
+	return append([]byte(nil), k.publicKey...), nil
+}
+
+func (k *pqPublicKey) SKI() []byte {
+	if len(k.publicKey) == 0 {
+		return nil
+	}
+
+	sum := sha256.Sum256(k.publicKey)
+	return sum[:]
+}
+
+func (k *pqPublicKey) Symmetric() bool {
+	return false
+}
+
+func (k *pqPublicKey) Private() bool {
+	return false
+}
+
+func (k *pqPublicKey) IsRawPublicKey() bool {
+	return true
+}
+
+func (k *pqPublicKey) PublicKey() (bccsp.Key, error) {
+	return k, nil
+}
diff --git a/bccsp/sw/pqkeystore.go b/bccsp/sw/pqkeystore.go
