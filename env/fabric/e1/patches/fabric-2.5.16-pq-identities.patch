index 0000000..f5e8ee6
--- /dev/null
+++ b/bccsp/sw/pqkeystore.go
@@ -0,0 +1,88 @@
+package sw
+
+import (
+	"encoding/asn1"
+	"encoding/pem"
+	"errors"
+)
+
+const pqPrivateKeyPEMType = "FABRIC PQ PRIVATE KEY"
+
+type pqPrivateKeyASN1 struct {
+	Algorithm string
+	SecretKey []byte
+	PublicKey []byte
+}
+
+func pqPrivateKeyToPEM(k *pqPrivateKey, pwd []byte) ([]byte, error) {
+	if k == nil {
+		return nil, errors.New("PQ private key is nil")
+	}
+	if len(pwd) != 0 {
+		return nil, errors.New("encrypted PQ private keys are not supported")
+	}
+	if k.algorithm == "" {
+		return nil, errors.New("PQ private key has empty algorithm")
+	}
+	if len(k.secretKey) == 0 {
+		return nil, errors.New("PQ private key has empty secret key")
+	}
+	if len(k.publicKey) == 0 {
+		return nil, errors.New("PQ private key has empty public key")
+	}
+
+	der, err := asn1.Marshal(pqPrivateKeyASN1{
+		Algorithm: k.algorithm,
+		SecretKey: k.secretKey,
+		PublicKey: k.publicKey,
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return pem.EncodeToMemory(&pem.Block{
+		Type:  pqPrivateKeyPEMType,
+		Bytes: der,
+	}), nil
+}
+
+func pemToPQPrivateKey(raw, pwd []byte) (*pqPrivateKey, error) {
+	if len(pwd) != 0 {
+		return nil, errors.New("encrypted PQ private keys are not supported")
+	}
+
+	block, rest := pem.Decode(raw)
+	if block == nil {
+		return nil, errors.New("failed decoding PQ private key PEM")
+	}
+	if len(rest) != 0 {
+		return nil, errors.New("trailing data after PQ private key PEM")
+	}
+	if block.Type != pqPrivateKeyPEMType {
+		return nil, errors.New("invalid PQ private key PEM type")
+	}
+
+	var decoded pqPrivateKeyASN1
+	restDER, err := asn1.Unmarshal(block.Bytes, &decoded)
+	if err != nil {
+		return nil, err
+	}
+	if len(restDER) != 0 {
+		return nil, errors.New("trailing data in PQ private key")
+	}
+	if decoded.Algorithm == "" {
+		return nil, errors.New("PQ private key has empty algorithm")
+	}
+	if len(decoded.SecretKey) == 0 {
+		return nil, errors.New("PQ private key has empty secret key")
+	}
+	if len(decoded.PublicKey) == 0 {
+		return nil, errors.New("PQ private key has empty public key")
+	}
+
+	return &pqPrivateKey{
+		algorithm: decoded.Algorithm,
+		secretKey: append([]byte(nil), decoded.SecretKey...),
+		publicKey: append([]byte(nil), decoded.PublicKey...),
+	}, nil
+}
diff --git a/bccsp/sw/pqx509.go b/bccsp/sw/pqx509.go
new file mode 100644
index 0000000..27f0c15
--- /dev/null
+++ b/bccsp/sw/pqx509.go
@@ -0,0 +1,41 @@
+package sw
+
+import (
+	"crypto/x509"
+	"encoding/asn1"
+	"errors"
+)
+
+var pqIdentityExtensionOID = asn1.ObjectIdentifier{1, 3, 6, 1, 3, 9999, 1}
+
+type pqIdentityExtension struct {
+	Algorithm string
+	PublicKey []byte
+}
+
+func pqIdentityFromCertificate(cert *x509.Certificate) (*pqIdentityExtension, error) {
+	for _, ext := range cert.Extensions {
+		if !ext.Id.Equal(pqIdentityExtensionOID) {
+			continue
+		}
+
+		var pqExt pqIdentityExtension
+		rest, err := asn1.Unmarshal(ext.Value, &pqExt)
+		if err != nil {
+			return nil, err
+		}
+		if len(rest) != 0 {
+			return nil, errors.New("trailing data in PQ identity extension")
+		}
+		if pqExt.Algorithm == "" {
+			return nil, errors.New("PQ identity extension has empty algorithm")
+		}
+		if len(pqExt.PublicKey) == 0 {
+			return nil, errors.New("PQ identity extension has empty public key")
+		}
+
+		return &pqExt, nil
+	}
+
+	return nil, nil
+}
