+func TestGetSigningIdentityFromConfWithPQIdentity(t *testing.T) {
+	tmpDir := t.TempDir()
+
+	var oqsSigner oqs.Signature
+	err := oqsSigner.Init("ML-DSA-44", nil)
+	require.NoError(t, err)
+	defer oqsSigner.Clean()
+
+	pqPublicKey, err := oqsSigner.GenerateKeyPair()
+	require.NoError(t, err)
+
+	pqSecretKey := oqsSigner.ExportSecretKey()
+
+	// The PQ public/private keys use SHA-256(publicKey) as their BCCSP SKI.
+	ski := sha256.Sum256(pqPublicKey)
+	alias := hex.EncodeToString(ski[:])
+
+	// Match the on-disk ASN.1/PEM format used by sw.pqPrivateKey.
+	pqKeyDER, err := asn1.Marshal(struct {
+		Algorithm string
+		SecretKey []byte
+		PublicKey []byte
+	}{
+		Algorithm: "ML-DSA-44",
+		SecretKey: pqSecretKey,
+		PublicKey: pqPublicKey,
+	})
+	require.NoError(t, err)
+
+	pqKeyPEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "FABRIC PQ PRIVATE KEY",
+		Bytes: pqKeyDER,
+	})
+
+	err = os.WriteFile(
+		filepath.Join(tmpDir, alias+"_pqpriv"),
+		pqKeyPEM,
+		0o600,
+	)
+	require.NoError(t, err)
+
+	// Embed the PQ algorithm and public key in a non-critical X.509 extension.
+	extensionValue, err := asn1.Marshal(struct {
+		Algorithm string
+		PublicKey []byte
+	}{
+		Algorithm: "ML-DSA-44",
+		PublicKey: pqPublicKey,
+	})
+	require.NoError(t, err)
+
+	pqExtensionOID := asn1.ObjectIdentifier{1, 3, 6, 1, 3, 9999, 1}
+
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	caTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject: pkix.Name{
+			CommonName: "fabric-pq-test-ca",
+		},
+		NotBefore:             time.Now().Add(-time.Minute),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRLSign,
+	}
+
+	caDER, err := x509.CreateCertificate(
+		rand.Reader,
+		caTemplate,
+		caTemplate,
+		&caKey.PublicKey,
+		caKey,
+	)
+	require.NoError(t, err)
+
+	caCert, err := x509.ParseCertificate(caDER)
+	require.NoError(t, err)
+
+	leafKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	leafTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject: pkix.Name{
+			CommonName: "fabric-pq-msp-test",
+		},
+		NotBefore:             time.Now().Add(-time.Minute),
+		NotAfter:              time.Now().Add(time.Hour),
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageDigitalSignature,
+		ExtraExtensions: []pkix.Extension{
+			{
+				Id:       pqExtensionOID,
+				Critical: false,
+				Value:    extensionValue,
+			},
+		},
+	}
+
+	certDER, err := x509.CreateCertificate(
+		rand.Reader,
+		leafTemplate,
+		caCert,
+		&leafKey.PublicKey,
+		caKey,
+	)
+	require.NoError(t, err)
+
+	certPEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "CERTIFICATE",
+		Bytes: certDER,
+	})
+
+	ks, err := sw.NewFileBasedKeyStore(nil, tmpDir, false)
+	require.NoError(t, err)
+
+	csp, err := sw.NewWithParams(256, "SHA2", ks)
+	require.NoError(t, err)
+
+	// Reuse the already configured MSP options, but replace its BCCSP
+	// with the temporary PQ-aware keystore for this test only.
+	testMSP := *localMsp.(*bccspmsp)
+	testMSP.bccsp = csp
+
+	testOpts := *localMsp.(*bccspmsp).opts
+	testOpts.Roots = x509.NewCertPool()
+	testOpts.Roots.AddCert(caCert)
+	testMSP.opts = &testOpts
+
+	sigid := &msp.SigningIdentityInfo{
+		PublicSigner: certPEM,
+	}
+
+	signingIdentity, err := testMSP.getSigningIdentityFromConf(sigid)
+	require.NoError(t, err)
+	require.NotNil(t, signingIdentity)
+
+	message := []byte("fabric-pq-msp-signing-test")
+
+	signature, err := signingIdentity.Sign(message)
+	require.NoError(t, err)
+	require.NotEmpty(t, signature)
+
+	publicIdentity := signingIdentity.GetPublicVersion()
+
+	err = publicIdentity.Verify(message, signature)
+	require.NoError(t, err)
+}
