+package sw
+
+import (
+	"crypto"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"math/big"
+	"os"
+	"testing"
+	"time"
+	"fmt"
+
+	"github.com/hyperledger/fabric/bccsp"
+	bccspsigner "github.com/hyperledger/fabric/bccsp/signer"
+	oqs "github.com/open-quantum-safe/liboqs-go/oqs"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPQKeyStoreSignVerify(t *testing.T) {
+	tmpDir, err := os.MkdirTemp("", "fabric-pq-keystore-*")
+	require.NoError(t, err)
+	defer os.RemoveAll(tmpDir)
+
+	var oqsSigner oqs.Signature
+	err = oqsSigner.Init("ML-DSA-44", nil)
+	require.NoError(t, err)
+	defer oqsSigner.Clean()
+
+	publicKey, err := oqsSigner.GenerateKeyPair()
+	require.NoError(t, err)
+
+	secretKey := oqsSigner.ExportSecretKey()
+
+	privateKey := &pqPrivateKey{
+		algorithm: "ML-DSA-44",
+		secretKey: append([]byte(nil), secretKey...),
+		publicKey: append([]byte(nil), publicKey...),
+	}
+
+	ks := &fileBasedKeyStore{}
+	err = ks.Init(nil, tmpDir, false)
+	require.NoError(t, err)
+
+	err = ks.StoreKey(privateKey)
+	require.NoError(t, err)
+
+	loadedKey, err := ks.GetKey(privateKey.SKI())
+	require.NoError(t, err)
+
+	loadedPrivateKey, ok := loadedKey.(*pqPrivateKey)
+	require.True(t, ok)
+	require.NotNil(t, loadedPrivateKey)
+	require.True(t, loadedPrivateKey.Private())
+
+	csp, err := NewWithParams(256, "SHA2", ks)
+	require.NoError(t, err)
+
+	for i := 0; i < 2; i++ {
+		digest := []byte(fmt.Sprintf("test-digest-%d", i))
+
+		signature, err := csp.Sign(loadedKey, digest, nil)
+		require.NoError(t, err)
+
+		valid, err := csp.Verify(loadedKey, signature, digest, nil)
+		require.NoError(t, err)
+		require.True(t, valid)
+	}
+}
+
+func TestPQCryptoSignerBridge(t *testing.T) {
+	tmpDir, err := os.MkdirTemp("", "fabric-pq-signer-*")
+	require.NoError(t, err)
+	defer os.RemoveAll(tmpDir)
+
+	var oqsSigner oqs.Signature
+	err = oqsSigner.Init("ML-DSA-44", nil)
+	require.NoError(t, err)
+	defer oqsSigner.Clean()
+
+	publicKey, err := oqsSigner.GenerateKeyPair()
+	require.NoError(t, err)
+
+	secretKey := oqsSigner.ExportSecretKey()
+
+	privateKey := &pqPrivateKey{
+		algorithm: "ML-DSA-44",
+		secretKey: append([]byte(nil), secretKey...),
+		publicKey: append([]byte(nil), publicKey...),
+	}
+
+	ks := &fileBasedKeyStore{}
+	err = ks.Init(nil, tmpDir, false)
+	require.NoError(t, err)
+
+	err = ks.StoreKey(privateKey)
+	require.NoError(t, err)
+
+	loadedKey, err := ks.GetKey(privateKey.SKI())
+	require.NoError(t, err)
+
+	csp, err := NewWithParams(256, "SHA2", ks)
+	require.NoError(t, err)
+
+	cryptoSigner, err := bccspsigner.New(csp, loadedKey)
+	require.NoError(t, err)
+
+	digest := []byte("fabric-pq-crypto-signer-test")
+
+	signature, err := cryptoSigner.Sign(rand.Reader, digest, crypto.Hash(0))
+	require.NoError(t, err)
+
+	publicBCCSPKey, err := loadedKey.PublicKey()
+	require.NoError(t, err)
+
+	valid, err := csp.Verify(publicBCCSPKey, signature, digest, nil)
+	require.NoError(t, err)
+	require.True(t, valid)
+
+	rawPublic, ok := cryptoSigner.Public().([]byte)
+	require.True(t, ok)
+	require.Equal(t, publicKey, rawPublic)
+}
+
+func TestPQX509ImportMatchesPrivateKey(t *testing.T) {
+	tmpDir, err := os.MkdirTemp("", "fabric-pq-x509-*")
+	require.NoError(t, err)
+	defer os.RemoveAll(tmpDir)
+
+	var oqsSigner oqs.Signature
+	err = oqsSigner.Init("ML-DSA-44", nil)
+	require.NoError(t, err)
+	defer oqsSigner.Clean()
+
+	pqPublicKeyBytes, err := oqsSigner.GenerateKeyPair()
+	require.NoError(t, err)
+
+	pqSecretKey := oqsSigner.ExportSecretKey()
+
+	privateKey := &pqPrivateKey{
+		algorithm: "ML-DSA-44",
+		secretKey: append([]byte(nil), pqSecretKey...),
+		publicKey: append([]byte(nil), pqPublicKeyBytes...),
+	}
+
+	ks := &fileBasedKeyStore{}
+	err = ks.Init(nil, tmpDir, false)
+	require.NoError(t, err)
+
+	err = ks.StoreKey(privateKey)
+	require.NoError(t, err)
+
+	extensionValue, err := asn1.Marshal(pqIdentityExtension{
+		Algorithm: "ML-DSA-44",
+		PublicKey: pqPublicKeyBytes,
+	})
+	require.NoError(t, err)
+
+	ecdsaKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject: pkix.Name{
+			CommonName: "fabric-pq-test",
+		},
+		NotBefore: time.Now().Add(-time.Minute),
+		NotAfter:  time.Now().Add(time.Hour),
+		ExtraExtensions: []pkix.Extension{
+			{
+				Id:       pqIdentityExtensionOID,
+				Critical: false,
+				Value:    extensionValue,
+			},
+		},
+	}
+
+	certDER, err := x509.CreateCertificate(
+		rand.Reader,
+		template,
+		template,
+		&ecdsaKey.PublicKey,
+		ecdsaKey,
+	)
+	require.NoError(t, err)
+
+	cert, err := x509.ParseCertificate(certDER)
+	require.NoError(t, err)
+
+	csp, err := NewWithParams(256, "SHA2", ks)
+	require.NoError(t, err)
+
+	importedKey, err := csp.KeyImport(
+		cert,
+		&bccsp.X509PublicKeyImportOpts{Temporary: true},
+	)
+	require.NoError(t, err)
+
+	importedPQKey, ok := importedKey.(*pqPublicKey)
+	require.True(t, ok)
+	require.False(t, importedPQKey.Private())
+	require.Equal(t, "ML-DSA-44", importedPQKey.algorithm)
+	require.Equal(t, pqPublicKeyBytes, importedPQKey.publicKey)
+
+	require.Equal(t, privateKey.SKI(), importedKey.SKI())
+
+	loadedPrivateKey, err := csp.GetKey(importedKey.SKI())
+	require.NoError(t, err)
+
+	loadedPQPrivateKey, ok := loadedPrivateKey.(*pqPrivateKey)
+	require.True(t, ok)
+	require.Equal(t, privateKey.SKI(), loadedPQPrivateKey.SKI())
+}
