new file mode 100644
index 0000000..6bd6ed7
--- /dev/null
+++ b/bccsp/sw/pq.go
@@ -0,0 +1,69 @@
+package sw
+
+import (
+	"fmt"
+
+	"github.com/hyperledger/fabric/bccsp"
+	oqs "github.com/open-quantum-safe/liboqs-go/oqs"
+)
+
+func signPQ(k *pqPrivateKey, digest []byte) ([]byte, error) {
+	var signer oqs.Signature
+
+	secretKey := append([]byte(nil), k.secretKey...)
+
+	if err := signer.Init(k.algorithm, secretKey); err != nil {
+		return nil, fmt.Errorf("failed to initialize PQ signer %s: %w", k.algorithm, err)
+	}
+	defer signer.Clean()
+
+	signature, err := signer.Sign(digest)
+	if err != nil {
+		return nil, fmt.Errorf("failed to sign with %s: %w", k.algorithm, err)
+	}
+
+	return signature, nil
+}
+
+func verifyPQ(k *pqPublicKey, signature, digest []byte) (bool, error) {
+	var verifier oqs.Signature
+
+	if err := verifier.Init(k.algorithm, nil); err != nil {
+		return false, fmt.Errorf("failed to initialize PQ verifier %s: %w", k.algorithm, err)
+	}
+	defer verifier.Clean()
+
+	valid, err := verifier.Verify(digest, signature, k.publicKey)
+	if err != nil {
+		return false, fmt.Errorf("failed to verify with %s: %w", k.algorithm, err)
+	}
+
+	return valid, nil
+}
+
+type pqSigner struct{}
+
+func (s *pqSigner) Sign(k bccsp.Key, digest []byte, opts bccsp.SignerOpts) ([]byte, error) {
+	return signPQ(k.(*pqPrivateKey), digest)
+}
+
+type pqPrivateKeyVerifier struct{}
+
+func (v *pqPrivateKeyVerifier) Verify(k bccsp.Key, signature, digest []byte, opts bccsp.SignerOpts) (bool, error) {
+	privateKey := k.(*pqPrivateKey)
+
+	return verifyPQ(
+		&pqPublicKey{
+			algorithm: privateKey.algorithm,
+			publicKey: privateKey.publicKey,
+		},
+		signature,
+		digest,
+	)
+}
+
+type pqPublicKeyVerifier struct{}
+
+func (v *pqPublicKeyVerifier) Verify(k bccsp.Key, signature, digest []byte, opts bccsp.SignerOpts) (bool, error) {
+	return verifyPQ(k.(*pqPublicKey), signature, digest)
+}
